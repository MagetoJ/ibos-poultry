<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for Flock Batch Numbers -->
    <record id="sequence_poultry_flock" model="ir.sequence">
        <field name="name">Poultry Flock Sequence</field>
        <field name="code">poultry.flock</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
        <field name="prefix">FLOCK/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>

    <!-- Sequence for Growth Tracking -->
    <record id="sequence_poultry_growth_tracking" model="ir.sequence">
        <field name="name">Poultry Growth Tracking Sequence</field>
        <field name="code">poultry.growth.tracking</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
        <field name="prefix">GROWTH/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>

    <!-- Sequence for Slaughter Records -->
    <record id="sequence_poultry_slaughter" model="ir.sequence">
        <field name="name">Poultry Slaughter Sequence</field>
        <field name="code">poultry.slaughter</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
        <field name="prefix">SLAUGHT/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>

    <!-- Sequence for Internal Consumption -->
    <record id="sequence_internal_consumption" model="ir.sequence">
        <field name="name">Internal Consumption Sequence</field>
        <field name="code">stock.picking.internal.consumption</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
        <field name="prefix">INT-CONS/%(year)s/%(month)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>
</odoo>
