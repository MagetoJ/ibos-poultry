<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Vaccine and Medicine Products -->
    
    <!-- Chickstart -->
    <record id="product_chickstart" model="product.product">
        <field name="name">Chickstart</field>
        <field name="type">consu</field>
        <field name="poultry_product_type">medicine</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="is_storable" eval="True"/>
        <field name="is_farm_raw_material" eval="True"/>
        <field name="list_price">0.00</field>
        <field name="standard_price">0.00</field>
        <field name="uom_id" ref="uom.product_uom_unit"/>
        <field name="uom_po_id" ref="uom.product_uom_unit"/>
        <field name="purchase_ok">True</field>
        <field name="sale_ok">False</field>
    </record>
    
