<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
     <!-- Feed Products for HW Schedule -->
    <record id="product_feed_starter" model="product.product">
        <field name="name">Starter Feed</field>
        <field name="type">consu</field>
        <field name="categ_id" ref="product.product_category_all"/>
        <field name="poultry_product_type">feed</field>
        <field name="is_storable" eval="True"/>
        <field name="is_farm_raw_material" eval="True"/>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="uom_po_id" ref="uom.product_uom_kgm"/>
        <field name="list_price">0.0</field>
        <field name="standard_price">0.0</field>
        <field name="purchase_ok">True</field>
        <field name="sale_ok">False</field>
    </record>

    <record id="product_feed_mix" model="product.product">
        <field name="name">MIX Feed</field>
        <field name="type">consu</field>
