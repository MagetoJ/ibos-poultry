<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Poultry Medicine Usage List View -->
    <record id="poultry_medicine_usage_list_view" model="ir.ui.view">
        <field name="name">poultry.medicine.usage.list</field>
        <field name="model">poultry.medicine.usage</field>
        <field name="arch" type="xml">
            <list string="Medicine Usage" sample="1">
                <field name="date"/>
                <field name="flock_id"/>
                <field name="growth_tracking_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="purpose"/>
                <field name="cost_per_unit" widget="monetary"/>
                <field name="total_cost" widget="monetary" sum="Total Cost"/>
            </list>
        </field>
    </record>

    <!-- Poultry Medicine Usage Form View -->
    <record id="poultry_medicine_usage_form_view" model="ir.ui.view">
        <field name="name">poultry.medicine.usage.form</field>
        <field name="model">poultry.medicine.usage</field>
        <field name="arch" type="xml">
            <form string="Medicine Usage">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="product_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="flock_id"/>
                            <field name="growth_tracking_id"/>
                            <field name="purpose"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="cost_per_unit" widget="monetary"/>
                            <field name="total_cost" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="stock_move_id"/>
                            <field name="landed_cost_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Add any notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medicine Usage Dialog Form (used in One2many) -->
    <record id="poultry_medicine_usage_dialog_form" model="ir.ui.view">
        <field name="name">poultry.medicine.usage.dialog.form</field>
        <field name="model">poultry.medicine.usage</field>
        <field name="arch" type="xml">
            <form string="Record Medicine/Vaccine Usage">
                <group>
                    <group>
                        <field name="flock_id" invisible="1"/>
                        <field name="growth_tracking_id" invisible="1"/>
                        <field name="date" readonly="1"/>
                        <field name="product_id" options="{'no_create': True}" readonly="1"/>
                        <field name="quantity" readonly="1"/>
                        <field name="uom_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="purpose" readonly="1"/>
                        <field name="cost_per_unit" widget="monetary"/>
                        <field name="total_cost" widget="monetary"/>
                    </group>
                </group>
                <group>
                    <field name="notes" placeholder="Additional notes..." nolabel="1"/>
                </group>
                <footer>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Poultry Medicine Usage Graph View -->
    <record id="poultry_medicine_usage_graph_view" model="ir.ui.view">
        <field name="name">poultry.medicine.usage.graph</field>
        <field name="model">poultry.medicine.usage</field>
        <field name="arch" type="xml">
            <graph string="Medicine Usage Trends" type="line" sample="1">
                <field name="date" type="row" interval="day"/>
                <field name="quantity" type="measure"/>
                <field name="total_cost" type="measure"/>
            </graph>
        </field>
    </record>
</odoo>
