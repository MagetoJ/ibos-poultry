<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Poultry Slaughter List View -->
    <record id="poultry_slaughter_list_view" model="ir.ui.view">
        <field name="name">poultry.slaughter.list</field>
        <field name="model">poultry.slaughter</field>
        <field name="arch" type="xml">
            <list string="Slaughter Records">
                <field name="name"/>
                <field name="slaughter_date"/>
                <field name="batch_number"/>
                <field name="poultry_location_id"/>
                <field name="quantity_to_slaughter"/>
                <field name="quantity_slaughtered"/>
                <field name="total_live_weight"/>
                <field name="total_revenue"/>
                <field name="net_profit"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'scheduled'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Poultry Slaughter Kanban View -->
<record id="poultry_slaughter_kanban_view" model="ir.ui.view">
    <field name="name">poultry.slaughter.kanban</field>
    <field name="model">poultry.slaughter</field>
    <field name="arch" type="xml">

        <kanban class="o_kanban_small_column">

            <!-- Fields -->
            <field name="name"/>
            <field name="batch_number"/>
            <field name="state"/>
            <field name="slaughter_date"/>
            <field name="poultry_location_id"/>
            <field name="quantity_to_slaughter"/>
            <field name="quantity_slaughtered"/>
            <field name="total_live_weight"/>
            <field name="net_profit"/>

            <templates>

                <t t-name="kanban-box">

                    <div t-attf-class="
                        oe_kanban_card
                        oe_kanban_global_click
                        o_kanban_record
                        {{ record.state.raw_value }}
                    ">

                        <!-- Header -->
                        <div class="o_kanban_header">

                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>

                            <div class="o_kanban_subtitle">
                                Batch: <field name="batch_number"/>
                            </div>

                        </div>

                        <!-- Body -->
                        <div class="o_kanban_content">

                            <ul class="o_kanban_details_list">

                                <li>
                                    <i class="fa fa-calendar"/>
                                    Date:
                                    <field name="slaughter_date"/>
                                </li>

                                <li>
                                    <i class="fa fa-map-marker"/>
                                    Location: 
                                    <field name="poultry_location_id"/>
                                </li>

                                <li>
                                    <i class="fa fa-balance-scale"/>
                                    Planned:
                                    <field name="quantity_to_slaughter"/> birds
                                </li>

                                <li t-if="record.quantity_slaughtered.raw_value">
                                    <i class="fa fa-check-circle"/>
                                    Processed:
                                    <field name="quantity_slaughtered"/> birds
                                </li>

                                <li t-if="record.total_live_weight.raw_value">
                                    <i class="fa fa-balance-scale"/>
                                    Weight:
                                    <field name="total_live_weight"/>g
                                </li>

                                <li t-if="record.net_profit.raw_value">

                                    <i class="fa fa-money"/>

                                    Profit:
                                    <field name="net_profit" widget="monetary"/>

                                </li>

                            </ul>

                        </div>

                        <!-- Footer -->
                        <div class="o_kanban_footer">

                            <field name="state"
                                   widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-warning="state == 'scheduled'"
                                   decoration-success="state == 'completed'"
                                   decoration-danger="state == 'cancelled'"/>

                        </div>

                    </div>

                </t>

            </templates>

        </kanban>

    </field>
</record>


    <!-- Poultry Slaughter Form View -->
    <record id="poultry_slaughter_form_view" model="ir.ui.view">
        <field name="name">poultry.slaughter.form</field>
        <field name="model">poultry.slaughter</field>
        <field name="arch" type="xml">
            <form string="Slaughter Record">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" 
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_complete" string="Complete" type="object" 
                            invisible="state != 'scheduled'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state not in ['draft', 'scheduled']"/>
                    <button name="action_draft" string="Set to Draft" type="object" 
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,scheduled,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_manufacturing_order" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-cogs"
                                invisible="manufacturing_order_count == 0">
                            <field name="manufacturing_order_count" widget="statinfo" string="Manufacturing Order"/>
                        </button>
                    </div>
                    <group>
                        <group string="Flock Information">
                            <field name="growth_tracking_id" readonly="state != 'draft'"/>
                            <field name="flock_id" readonly="1"/>
                            <field name="batch_number" readonly="1"/>
                            <field name="poultry_location_id" readonly="1"/>
                            <field name="slaughter_date" readonly="state not in ['draft', 'scheduled']"/>
                        </group>
                        <group string="Quantity">
                            <field name="available_birds" readonly="1"/>
                            <field name="quantity_to_slaughter" readonly="state != 'draft'"/>
                            <field name="quantity_slaughtered" readonly="1"/>
                            <field name="age_at_slaughter" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Weight Information">
                            <field name="average_weight" readonly="state not in ['draft', 'scheduled']"/>
                            <field name="total_live_weight" readonly="1"/>
                            <field name="total_live_weight_kg" readonly="1"/>
                        </group>
                        <group string="Slaughter Details">
                            <field name="slaughter_house" readonly="state not in ['draft', 'scheduled']"/>
                            <field name="buyer" readonly="state not in ['draft', 'scheduled']"/>
                        </group>
                    </group>
                    <group>
                        <group string="Financial">
                            <field name="price_per_kg" readonly="state not in ['draft', 'scheduled']"/>
                            <field name="total_revenue" readonly="1"/>
                        </group>
                        <group string="Costs">
                            <field name="transport_cost" readonly="state not in ['draft', 'scheduled']"/>
                            <field name="slaughter_cost" readonly="state not in ['draft', 'scheduled']"/>
                            <field name="other_costs" readonly="state not in ['draft', 'scheduled']"/>
                            <field name="total_costs" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="net_profit" readonly="1" class="oe_subtotal_footer_separator"/>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about the slaughter..." 
                                   readonly="state == 'completed'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Poultry Slaughter Action -->
    <record id="poultry_slaughter_action" model="ir.actions.act_window">
        <field name="name">Slaughter Records</field>
        <field name="res_model">poultry.slaughter</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No slaughter records found
            </p>
            <p>
                Slaughter records track when birds are processed for sale.
            </p>
        </field>
    </record>
</odoo>
