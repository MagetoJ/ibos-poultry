<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Poultry Location List View -->
    <record id="poultry_location_list_view" model="ir.ui.view">
        <field name="name">poultry.location.list</field>
        <field name="model">poultry.location</field>
        <field name="arch" type="xml">
            <list string="Poultry Locations" create="0">
                <field name="name"/>
                <field name="code"/>
                <field name="location_type"/>
                <field name="capacity"/>
                <field name="current_occupancy"/>
                <field name="stock_location_id"/>
                <!-- <field name="active" widget="boolean_toggle"/> -->
            </list>
        </field>
    </record>

    <!-- Poultry Location Form View -->
    <record id="poultry_location_form_view" model="ir.ui.view">
        <field name="name">poultry.location.form</field>
        <field name="model">poultry.location</field>
        <field name="arch" type="xml">
            <form string="Poultry Location" create="0" edit="1">
                <header>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" 
                            invisible="active == True"/>
                    <div class="oe_button_box" name="button_box">
                        <!-- <button name="toggle_active" type="object" class="oe_stat_button">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button> -->
                        <button name="action_view_current_flock" type="object" 
                                class="oe_stat_button" icon="fa-line-chart"
                                invisible="not current_growth_tracking_id">
                            <field name="current_growth_tracking_id" invisible="1"/>
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="current_occupancy"/></span>
                                <span class="o_stat_text">Live Birds</span>
                            </div>                            
                        </button>
                        <button class="oe_stat_button" icon="fa-heartbeat">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="current_dead_count"/></span>
                                <span class="o_stat_text">Deaths</span>
                            </div>
                        </button>
                        <button name="action_view_processing_orders" type="object" 
                                class="oe_stat_button" icon="fa-industry"
                                invisible="processing_order_count == 0">
                            <field name="processing_order_count" invisible="1"/>
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="current_slaughtered_count"/></span>
                                <span class="o_stat_text">Partially Processed</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-certificate">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="avg_weight"/></span>
                                <span class="o_stat_text">Average Weight (kg)</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-balance-scale">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="current_total_weight"/></span>
                                <span class="o_stat_text">Total Weight (kg)</span>
                            </div>
                        </button>
                        <button name="action_view_growth_history" type="object" 
                                class="oe_stat_button" icon="fa-history">
                            <field name="growth_history_count" widget="statinfo" string="Flock History"/>
                        </button>
                        <button name="action_view_employees" type="object" 
                                class="oe_stat_button" icon="fa-users"
                                invisible="employee_count == 0">
                            <field name="employee_count" widget="statinfo" string="Assignees"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., House 1, Pen A"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="location_type"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="current_occupancy"/>
                            <field name="stock_location_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Growth History" name="growth_history">
                            <field name="growth_tracking_history_ids" readonly="1">
                                <list string="Growth Tracking History">
                                    <field name="name"/>
                                    <field name="flock_id"/>
                                    <field name="tracking_date"/>
                                    <field name="initial_quantity"/>
                                    <field name="current_quantity"/>
                                    <field name="age_days"/>
                                    <field name="fcr"/>
                                    <field name="weight_progress" widget="progressbar"/>
                                    <field name="state" widget="badge" 
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'confirmed'"
                                           decoration-warning="state == 'partially_processed'"
                                           decoration-danger="state == 'slaughtered'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Responsible Employees" name="employees">
                            <field name="employee_ids"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes about this location..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Poultry Location Kanban View -->
    <record id="poultry_location_kanban_view" model="ir.ui.view">
        <field name="name">poultry.location.kanban</field>
        <field name="model">poultry.location</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="code"/>
                <field name="location_type"/>
                <field name="capacity"/>
                <field name="current_occupancy"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span t-if="record.code.raw_value">
                                        [<field name="code"/>]
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="location_type"/>
                                <div>
                                    Occupancy: <field name="current_occupancy"/> / <field name="capacity"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Poultry Location Action -->
    <record id="poultry_location_action" model="ir.actions.act_window">
        <field name="name">Poultry Locations</field>
        <field name="res_model">poultry.location</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first poultry location
            </p>
            <p>
                Poultry locations represent physical areas where birds are kept,
                such as houses, pens, or brooders.
            </p>
        </field>
    </record>
</odoo>
