<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Growth Processing Wizard Form View -->
    <record id="growth_slaughter_wizard_form_view" model="ir.ui.view">
        <field name="name">growth.slaughter.wizard.form</field>
        <field name="model">growth.slaughter.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Processing Order">
                <group>
                    <group string="Flock Information">
                        <field name="growth_tracking_id" readonly="1"/>
                        <field name="flock_id" readonly="1"/>
                        <field name="available_birds" readonly="1"/>
                    </group>
                    <group string="Processing Details">
                        <field name="quantity_to_process"/>
                        <field name="processing_date"/>
                        <field name="average_weight"/>
                        
                    </group>
                </group>
                <group>
                    <group string="Product Selection">
                        <div class="alert alert-info" role="alert">
                                Only products set as main BoM are selectable. Go to the BoM form view to set a BoM as main.
                            </div>
                        <field name="product_tmpl_id" invisible="1"/>
                        <field name="product_id" 
                               domain="[('product_tmpl_id.bom_ids.is_main_bom', '=', True)]"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="bom_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="has_byproducts" invisible="1"/>
                    </group>
                    <group string="Expected Output">
                        <!-- <field name="total_live_weight" readonly="1"/> -->
                        <field name="total_live_weight_kg" readonly="1"/>
                        <!-- <field name="total_byproduct_quantity" readonly="1" invisible="not has_byproducts"/> -->
                        <!-- <field name="total_byproduct_percentage" readonly="1" invisible="not has_byproducts"/> -->
                        <field name="total_cost_share_percentage" readonly="1" invisible="not has_byproducts"
                               decoration-danger="total_cost_share_percentage > 100"
                               decoration-success="total_cost_share_percentage == 100"/>
                        <field name="main_product_quantity" readonly='0' invisible="not has_byproducts"
                               decoration-danger="main_product_quantity &lt;= 0"
                               decoration-success="main_product_quantity &gt; 0"/>
                        <!-- <field name="main_product_percentage" readonly="1" invisible="not has_byproducts" 
                               decoration-danger="main_product_percentage &lt; 0"
                               decoration-success="main_product_percentage &gt;= 0 and main_product_percentage &lt;= 100"/> -->
                    </group>
                </group>
                <notebook invisible="not has_byproducts">
                    <page string="Byproducts" name="byproducts">
                        <group>
                            <div class="alert alert-info" role="alert">
                                Enter the quantity for each product/byproduct (including waste). The main product quantity will be calculated automatically as the remainder.
                            </div>
                        </group>
                        <field name="byproduct_line_ids" nolabel="1">
                            <list editable="bottom" >
                                <field name="byproduct_id" column_invisible="1"/>
                                <field name="product_id"/>
                                <field name="quantity" sum="total_quantity"/>
                                <field name="uom_id"/>
                                <field name="cost_share" sum="total_cost_share"/>
                                <!-- <field name="percentage" sum="total_percentage"/> -->
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Create Processing Order" name="action_create_manufacturing_order" 
                            invisible="total_cost_share_percentage == 0"
                            type="object" class="btn-primary"/>
                    <button string="Create Processing Order" name="action_create_manufacturing_order" 
                            confirm="You have not set up your cost share percentages. Do you want to continue?"
                            invisible="total_cost_share_percentage > 0"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
